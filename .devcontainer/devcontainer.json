{
  "name": "MOAT Devcontainer",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  "initializeCommand": "docker network create moat 2>/dev/null || true",
  "runArgs": [
    "--network=moat",
    "--name=moat-devcontainer",
    "--env-file",
    "${localWorkspaceFolder}/.env"
  ],
  "remoteUser": "vscode",

  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "installMaven": "false",
      "installGradle": "true"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.0": {
      "version": "latest",
      "moby": false
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "pkief.material-icon-theme",
        "ms-azuretools.vscode-docker",
        "ms-ossdata.vscode-pgsql",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "angular.ng-template",
        "GitHub.github-vscode-theme",
        "eamodio.gitlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "material-icon-theme.folders.theme": "specific",
        "[java]": {
          "editor.defaultFormatter": "redhat.java"
        },
        "java.configuration.updateBuildConfiguration": "interactive",
        "java.compile.nullAnalysis.mode": "automatic",
        "workbench.colorTheme": "GitHub Dark Default"
      }
    }
  },

  "forwardPorts": [8081, 4200],

  "postCreateCommand": "npm install -g @angular/cli@22"
}
